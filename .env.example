# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Public URL of the site (used for Paystack callbacks and metadata)
NEXT_PUBLIC_SITE_URL=https://www.aidylsluxury.com

# Neon Postgres (Vercel → Storage → Neon adds this automatically)
DATABASE_URL=

# Vercel Blob (Vercel → Storage → Blob adds this automatically)
BLOB_READ_WRITE_TOKEN=

# Paystack secret key. Use the TEST key (sk_test_...) until Lydia's account is live.
# Webhook URL to set in Paystack: https://<domain>/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# Admin dashboard (/admin). Password: at least 12 characters
ADMIN_PASSWORD=
# Long random string, 32+ characters: e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Email notifications via Resend (optional; without it emails are logged to the console)
RESEND_API_KEY=
MAIL_FROM="Aidyl's Luxury <orders@your-domain.com>"
OWNER_EMAIL=aidylenterprise@gmail.com

# Google Maps embed URL for the Contact page (Maps → Share → Embed a map → copy the src)
NEXT_PUBLIC_MAP_EMBED_URL=
